# Copy to .env and edit. All values are optional — sane defaults work for dev.
# On the real Pi, set at least API_URL + CLASSROOM_ID + DEVICE_ID.

# Backend — where the Nest API is reachable from the Pi (LAN IP on real deploy).
# Dev default: localhost. Pi example: http://192.168.1.50:3000
API_URL=http://localhost:3000

# Pin to one classroom/device (from Admin → Classrooms / Devices).
# If blank, the Pi auto-picks the first classroom + its paired device.
CLASSROOM_ID=
DEVICE_ID=
DEVICE_NAME=Classroom Pi

# Optional service account — lets the Pi POST /devices/:id/telemetry with auth.
# Create a lecturer/admin user for the Pi and put its creds here.
# If blank, telemetry is sent best-effort without auth (and may be rejected).
PI_EMAIL=
PI_PASSWORD=

# Behaviour
POLL_SESSION_S=5
POLL_MATERIAL_S=10
POLL_TELEMETRY_S=30
AUTO_OPEN_JITSI=true
# Leave blank to auto-detect chromium/chrome; or pin your kiosk command:
# e.g. chromium-browser --kiosk --noerrdialogs --disable-infobars
JITSI_BROWSER_CMD=
FULLSCREEN=true
