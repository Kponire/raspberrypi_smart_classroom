# Copy to .env and edit.
# On the real Pi, set at least API_URL + DEVICE_ID + PI_USERNAME + PI_PASSWORD.

# Backend — where the Nest API is reachable from the Pi (LAN IP on real deploy).
# Pi example: http://192.168.1.50:3000  |  Dev: http://localhost:3000
API_URL=http://localhost:3000

# Pin to one classroom/device (from Admin → Devices/Classrooms).
# If blank, the Pi auto-picks the first classroom + its paired device.
CLASSROOM_ID=
DEVICE_ID=
DEVICE_NAME=Classroom Pi

# Pi device credentials — must match piUsername/piPassword set when you
# registered the device in Admin → Devices. Used as headers on telemetry.
PI_USERNAME=
PI_PASSWORD=

# Behaviour
POLL_SESSION_S=5
POLL_MATERIAL_S=10
POLL_TELEMETRY_S=30
AUTO_OPEN_JITSI=true
# Leave blank to auto-detect chromium/chrome; or pin your kiosk command:
# e.g. chromium-browser --kiosk --noerrdialogs --disable-infobars
JITSI_BROWSER_CMD=
FULLSCREEN=true
